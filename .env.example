# RecordingNote ローカルサーバー設定
# このファイルを .env にコピーして必要な値だけ変更してください。
# start.sh / start.bat を使う場合は初回起動時に自動で作成されます。

# --- ノート生成（Gemini API・任意） ---------------------------------
# 後から Gemini API キーを設定する場合は、ここに貼り付けて保存してください。
# 空のままでも文字起こしは使えます。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 文字起こし（Haas-ja） ------------------------------------------
# 動作モード: auto（推奨）/ gpu / cpu
# auto は Linux + NVIDIA Ampere以降のGPU で公式版、それ以外（Mac/Windows/CPU）は ONNX版を使います。
HAAS_DEVICE=auto
# CPU（ONNX）使用時のスレッド数（空欄で自動・最大4）
HAAS_CPU_THREADS=

# GPUモード用設定（Linux + NVIDIA GPU 時）
HAAS_MODEL=third-intelligence/Haas-ja-v1.0
# GPUメモリが足りない場合は小さく（4〜8）、余裕があれば大きく（16〜32）
HAAS_BATCH_SIZE=8
# 任意: 固有名詞の読みを登録して認識を寄せる（GPUモードのみ有効）
# 例: HAAS_VOCABULARY_JSON={"考古学概説II": ["こうこがくがいせつ"]}
HAAS_VOCABULARY_JSON=

# CPUモード用設定（ONNX版 Haas-ja）
HAAS_ONNX_MODEL=oboroge0/Haas-ja-v1.0-onnx-quantized
HAAS_ONNX_REVISION=7f5ab0a4b1bf39db78afd6691eeecbc4f9d42e39

# --- サーバー -------------------------------------------------------
# 認証がないため、原則 127.0.0.1 のままにしてください。
HOST=127.0.0.1
PORT=8000
# アップロードできる音声の上限（MB）
MAX_UPLOAD_MB=2048
