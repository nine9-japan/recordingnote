# RecordingNote ローカルサーバー設定
# このファイルを .env にコピーして必要な値だけ変更してください。
# cp .env.example .env

# --- ノート生成（任意） ---------------------------------------------
# Gemini API キー。空のままでも文字起こしは使えます。
# 設定した場合はサーバーを再起動してください。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- 文字起こし -----------------------------------------------------
# Haas-ja のモデルID（通常は変更不要）
HAAS_MODEL=third-intelligence/Haas-ja-v1.0
# GPUメモリが足りない場合は小さく（4〜8）、余裕があれば大きく（16〜32）
HAAS_BATCH_SIZE=8
# 任意: 固有名詞の読みを登録して認識を寄せる
# 例: HAAS_VOCABULARY_JSON={"考古学概説II": ["こうこがくがいせつ"]}
HAAS_VOCABULARY_JSON=

# --- サーバー -------------------------------------------------------
# 認証がないため、原則 127.0.0.1 のままにしてください。
HOST=127.0.0.1
PORT=8000
# アップロードできる音声の上限（MB）
MAX_UPLOAD_MB=2048
